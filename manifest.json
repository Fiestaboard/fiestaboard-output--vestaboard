{
  "id": "vestaboard",
  "name": "Vestaboard",
  "version": "1.3.0",
  "description": "A Vestaboard Flagship, Note or Note array, over the Local API or the cloud.",
  "author": "FiestaBoard",
  "icon": "layout-grid",
  "category": "output",
  "plugin_type": "output",
  "screenshots": [
    {
      "src": "docs/board-display.png",
      "alt": "A Vestaboard Flagship showing a colour bar, FIESTABOARD and a morning weather line",
      "caption": "A Flagship driven over the Local API",
      "primary": true
    }
  ],
  "data_files": [
    "output/device-models.json"
  ],
  "output": {
    "output_api": 1,
    "device_models": {
      "$ref": "output/device-models.json"
    },
    "delivery": "push",
    "min_interval_ms": 0,
    "read_back": {
      "supported": true,
      "cost": "cheap",
      "suggested_interval_s": 30
    },
    "native_transitions": [
      "column",
      "reverse-column",
      "edges-to-center",
      "row",
      "diagonal",
      "random"
    ],
    "settings_schema": {
      "type": "object",
      "properties": {
        "api_mode": {
          "type": "string",
          "title": "Connection",
          "enum": [
            "local",
            "cloud"
          ],
          "default": "local",
          "ui:widget": "mode-cards",
          "ui:options": {
            "cards": [
              {
                "value": "local",
                "title": "Local API",
                "description": "Direct connection on your network"
              },
              {
                "value": "cloud",
                "title": "Cloud API",
                "description": "Through Vestaboard's cloud"
              }
            ]
          }
        },
        "host": {
          "type": "string",
          "title": "Board IP Address",
          "description": "Enter the address yourself, or find the board on your network.",
          "ui:placeholder": "192.168.1.100",
          "ui:widget": "device-picker",
          "ui:options": {
            "action": "discover",
            "value_key": "ip",
            "label_key": "hostname"
          },
          "ui:visible_when": {
            "api_mode": "local",
            "@device_type": [
              "flagship",
              "note"
            ]
          }
        },
        "local_api_key": {
          "type": "string",
          "title": "Local API Key",
          "description": "No key yet? Use Get API Key from Board with the enablement token from vestaboard.com/local-api.",
          "ui:placeholder": "Your local API key",
          "secret": true,
          "ui:visible_when": {
            "api_mode": "local",
            "@device_type": [
              "flagship",
              "note"
            ]
          }
        },
        "cloud_key": {
          "type": "string",
          "title": "Read/Write API Key",
          "description": "Found in the Vestaboard app under Settings → Read/Write API.",
          "ui:placeholder": "Enter R/W API key",
          "secret": true,
          "ui:visible_when": {
            "api_mode": "cloud",
            "@device_type": [
              "flagship",
              "note"
            ]
          }
        },
        "note_array_token": {
          "type": "string",
          "title": "Cloud API Token",
          "description": "The X-Vestaboard-Token for this Note array, from your Vestaboard Cloud API subscription.",
          "ui:placeholder": "Enter X-Vestaboard-Token",
          "secret": true,
          "ui:visible_when": {
            "api_mode": "cloud",
            "@device_type": "note_array"
          }
        },
        "tiles": {
          "type": "array",
          "title": "Board tiles",
          "description": "Click a slot to connect the Note that sits at that position on your wall. Use Identify to flash a slot number on a Note and confirm it is in the right place.",
          "ui:widget": "tile-grid",
          "ui:options": {
            "layout": "board",
            "item_actions": [
              "test_tile",
              "identify",
              "enable_local_api"
            ],
            "unique_fields": [
              "host",
              "port"
            ]
          },
          "ui:visible_when": {
            "api_mode": "local",
            "@device_type": "note_array"
          },
          "items": {
            "type": "object",
            "required": [
              "host",
              "local_api_key"
            ],
            "properties": {
              "row": {
                "type": "integer",
                "title": "Row",
                "minimum": 0
              },
              "col": {
                "type": "integer",
                "title": "Column",
                "minimum": 0
              },
              "host": {
                "type": "string",
                "title": "Board IP Address",
                "description": "Enter the address yourself, or find the board on your network.",
                "ui:placeholder": "192.168.1.100",
                "ui:widget": "device-picker",
                "ui:options": {
                  "action": "discover",
                  "value_key": "ip",
                  "label_key": "hostname"
                }
              },
              "port": {
                "type": "integer",
                "title": "Local API port",
                "minimum": 1,
                "maximum": 65535,
                "default": 7000
              },
              "local_api_key": {
                "type": "string",
                "title": "Local API Key",
                "description": "No key yet? Use Get API Key from Board with the enablement token from vestaboard.com/local-api.",
                "ui:placeholder": "Your local API key",
                "secret": true
              },
              "enabled": {
                "type": "boolean",
                "title": "Enabled",
                "default": true
              }
            }
          }
        },
        "port": {
          "type": "integer",
          "title": "Local API port",
          "minimum": 1,
          "maximum": 65535,
          "default": 7000,
          "ui:visible_when": {
            "api_mode": "local",
            "@device_type": [
              "flagship",
              "note"
            ]
          }
        }
      },
      "required": [
        "host",
        "local_api_key",
        "cloud_key",
        "note_array_token",
        "tiles"
      ],
      "ui:sections": [
        {
          "id": "advanced",
          "title": "Advanced",
          "fields": [
            "port"
          ],
          "collapsible": true,
          "collapsed": true
        }
      ]
    },
    "actions": [
      {
        "id": "test_connection",
        "label": "Test Connection"
      },
      {
        "id": "discover",
        "label": "Scan network",
        "description": "Find Vestaboards with the Local API on this network.",
        "visible_when": {
          "api_mode": "local"
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "timeout": {
              "type": "number",
              "title": "Scan seconds",
              "minimum": 1.0,
              "maximum": 15.0,
              "default": 4.0
            }
          }
        }
      },
      {
        "id": "test_tile",
        "label": "Test",
        "description": "Check that this Note's address and key reach its Local API.",
        "visible_when": {
          "api_mode": "local",
          "@device_type": "note_array"
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "row": {
              "type": "integer",
              "minimum": 0
            },
            "col": {
              "type": "integer",
              "minimum": 0
            },
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "local_api_key": {
              "type": "string",
              "secret": true
            }
          }
        }
      },
      {
        "id": "identify",
        "label": "Identify",
        "description": "Flash each note-array tile's position on it.",
        "visible_when": {
          "api_mode": "local",
          "@device_type": "note_array"
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "target": {
              "type": "string",
              "enum": [
                "tile",
                "all"
              ],
              "default": "tile"
            },
            "row": {
              "type": "integer",
              "minimum": 0
            },
            "col": {
              "type": "integer",
              "minimum": 0
            },
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "local_api_key": {
              "type": "string",
              "secret": true
            }
          }
        }
      },
      {
        "id": "detect_geometry",
        "label": "Auto-detect from board",
        "description": "Read the board's current layout and set its type and size to match.",
        "visible_when": {
          "not": {
            "api_mode": "local",
            "@device_type": "note_array"
          }
        },
        "auto_apply": true
      },
      {
        "id": "enable_local_api",
        "label": "Get API Key from Board",
        "description": "Exchange a Local API enablement token (from vestaboard.com/local-api) for a Local API key.",
        "visible_when": {
          "api_mode": "local"
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "enablement_token": {
              "type": "string",
              "title": "Enablement Token",
              "ui:placeholder": "Token from vestaboard.com/local-api",
              "secret": true,
              "minLength": 1
            },
            "host": {
              "type": "string",
              "title": "Board IP Address",
              "ui:placeholder": "192.168.1.100"
            }
          },
          "required": [
            "enablement_token"
          ]
        },
        "result_fields": {
          "api_key": {
            "secret": true,
            "fills": "local_api_key"
          }
        }
      }
    ]
  }
}
